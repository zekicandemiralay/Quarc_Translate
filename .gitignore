node_modules/
# Proton Drive writes these when two devices touch the same path. They're
# duplicates of already-ignored paths, but the renamed directory dodges the
# patterns above — e.g. "node_modules (# Name clash 2026-09-04 abc #)".
*Name clash*
__pycache__/
backend/data/
frontend/dist/
mobile/www/*
!mobile/www/.gitkeep
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/*.keystore
mobile/*.password.txt
mobile/ios/
mobile/signing/
desktop/src-tauri/target/
desktop/src-tauri/gen/
backup_*/
