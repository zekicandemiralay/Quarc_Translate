# ===================================================================
# WARNING: This file contains SECRET credentials. Do NOT commit it to git.
# Copy this file to .env and fill in the required values.
# ===================================================================

# Must be IDENTICAL to the JWT_SECRET used by the quarc-auth service (see
# Quarc_Store/auth/.env) and by every other Quarc app's .env — that's what
# makes one login work across every Quarc app, and what lets this app read a
# session cookie issued by quarc-auth.
#
# SECURITY: Use a long, random string (at least 32 characters). You can generate
# one with: openssl rand -hex 32
#
# The application will REFUSE REQUESTS (HTTP 500 "misconfigured") if this is left as the placeholder.
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters

# --- Translation engine (everything below is optional) ------------------
#
# How a pair is translated:
#   1. a dedicated model for the exact pair (Turkish, German, French, Spanish,
#      Italian, Portuguese, Czech, Finnish, Greek, Hungarian, Indonesian … <-> English)
#      — fast (~0.3 s a sentence), ~100–300 MB of RAM;
#   2. two dedicated models chained through English (German -> Turkish = German -> English -> Turkish);
#   3. NLLB-200 for everything else (~200 languages) — slower, ~1.5 GB of RAM.
# Models are downloaded on first use; the app shows the progress.

# RAM the loaded models may use together, in MB. When it is exceeded the least
# recently used model is unloaded. Default 2600 (NLLB 1.3B + a few dedicated pairs).
# MODEL_RAM_MB=2600

# Hard ceiling for the whole engine container. If something goes wrong the engine
# restarts — it can never take the other Quarc apps on this machine down with it.
# Default 4500m. Lower it with MODEL_RAM_MB if the machine is small.
# ENGINE_MEM_LIMIT=4500m

# Model for languages that have no dedicated one: "1.3B" (better, ~1.5 GB RAM) or
# "600M" (lighter, ~0.75 GB). Default 1.3B.
# NLLB_MODEL=1.3B

# "auto" chains two dedicated models through English when no direct one exists;
# "off" always uses NLLB for those pairs.
# PIVOT=auto

# Pairs downloaded in the background after every start, so nobody waits for them.
# Comma-separated "from:to". The first one is also loaded into memory.
# (This replaces WARM_PAIR.) Leave pairs you do not use out to save disk; "PREPARE_ON_START=" (empty) downloads nothing in advance.
# PREPARE_ON_START=tr:en,en:tr,en:de,de:en

# CPU threads for one translation, and how many translations run at once.
# TRANSLATE_THREADS=4
# TRANSLATE_CONCURRENCY=2

# Refuse to start a download when less than this many MB would be left on the volume.
# MIN_FREE_DISK_MB=1500

# --- Backend (optional) ---------------------------------------------------
#
# Maximum time (in milliseconds) to wait for one answer from the engine. Default: 45000
# ENGINE_TIMEOUT=45000

# Extra web origins allowed to call the API with the login cookie (comma-separated).
# You do NOT need this for the app itself, the Android app or the desktop app —
# they are always allowed. Every other website is refused, so a page you happen to
# open can't read your translation history.
# ALLOWED_ORIGINS=https://example.com
