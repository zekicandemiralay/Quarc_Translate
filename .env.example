# ===================================================================
# WARNING: This file contains SECRET credentials. Do NOT commit it to git.
# Copy this file to .env and fill in the required values.
# ===================================================================

# Must be IDENTICAL to the JWT_SECRET used by the quarc-auth service (see
# Quarc_Notes/auth/.env) and by every other Quarc app's .env — that's what
# makes one login work across every Quarc app, and what lets this app read a
# session cookie issued by quarc-auth.
# 
# SECURITY: Use a long, random string (at least 32 characters). You can generate
# one with: openssl rand -hex 32
#
# The application will FAIL TO START if this is left as the default value.
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters

# --- Translation engine (all optional) ---------------------------------
#
# How many translation models may stay in RAM at once, evicted least-recently-
# used. Each is ~300MB (OPUS-MT, used for Turkish<->English) to ~700MB
# (NLLB-200, used for every other pair) at int8. Default 2. Lower it to 1 if
# the host is short on memory; raise it if you switch between many languages
# and have RAM to spare.
# MAX_LOADED_MODELS=2

# CPU threads per translation. Default 4 — leaves cores for the other Quarc
# apps sharing the machine.
# TRANSLATE_THREADS=4

# Language pair preloaded when the engine starts, so the first translation
# doesn't pay for the model download/conversion. Default tr:en. Set to an
# empty value to skip warming entirely.
# WARM_PAIR=tr:en

# --- Backend (optional) ---------------------------------------------------
#
# Maximum time (in milliseconds) to wait for translation engine responses.
# Default: 30000 (30 seconds)
# ENGINE_TIMEOUT=30000

# Comma-separated list of allowed CORS origins. If not set, all origins are
# allowed (insecure for production). Example:
# ALLOWED_ORIGINS=https://quarcnet0.tail84500c.ts.net:4003,https://my-custom-domain.com
# ALLOWED_ORIGINS=

# Node.js environment. Set to 'production' for better error messages.
# NODE_ENV=production
