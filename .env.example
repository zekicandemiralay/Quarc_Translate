# Must be IDENTICAL to the JWT_SECRET used by the quarc-auth service (see
# Quarc_Notes/auth/.env) and by every other Quarc app's .env — that's what
# makes one login work across every Quarc app, and what lets this app read a
# session cookie issued by quarc-auth.
JWT_SECRET=change-this-to-a-long-random-string

# Optional. Comma-separated LibreTranslate language codes to load into the
# self-hosted translation engine. Fewer languages = smaller image download
# and faster first start. Leave unset to use the built-in default list
# (see docker-compose.yml). Full list of supported codes:
# https://github.com/LibreTranslate/LibreTranslate#supported-languages
# LT_LOAD_ONLY=en,tr,de,fr,es
